{
	"langrev": "1",
	"version": "0.1.0",
	"authors": ["tonis2 <tonis.anton18@gmail.com>"],
	"warnings": ["no-unused"],
	"sources": ["src/**"],
	"test-sources": ["test/**"],
	"dependency-search-paths": [],
	"dependencies": [],
	"output": "build",
	"targets": {
		"fastjs": { "type": "static-lib" },
		// Lexes (later: parses) every script in ../three.c3 and reports the first error in each.
		"lexcheck": { "type": "executable", "sources": ["tools/lexcheck.c3"] },
		// Parse, print, reparse, print again: the two prints must match.
		"parsecheck": { "type": "executable", "sources": ["tools/parsecheck.c3"] },
		// Runs scripts: fjs [--dump] file.js
		"fjs": { "type": "executable", "sources": ["tools/fjs.c3"] }
	}
}
