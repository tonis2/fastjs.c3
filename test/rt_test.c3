fn void value_encoding() @test
{
	test::eq(rt::integer(-5).as_int(), -5);
	test::eq(rt::integer(7).is_int(), true);
	test::eq(rt::integer(7).is_double(), false);
	test::eq(rt::double_value(1.5).is_double(), true);
	test::eq(rt::double_value(1.5).as_double(), 1.5);
	test::eq(rt::number(3.0).is_int(), true);
	test::eq(rt::number(-0.0).is_int(), false);
	test::eq(rt::number(0.5).is_double(), true);
	test::eq(rt::number(4294967296.0).is_double(), true);
	test::eq(rt::UNDEFINED.is_undefined(), true);
	test::eq(rt::UNDEFINED.is_double(), false);
	test::eq(rt::NULL.is_nullish(), true);
	test::eq(rt::boolean(true), rt::TRUE);
	// The hardware's default NaN must still read as a double, and odd NaNs are canonicalized.
	double nan = bitcast(0xFFF8_0000_0000_0000UL, double);
	test::eq(rt::double_value(nan).is_double(), true);
	test::eq((ulong)rt::double_value(bitcast(0xFFFF_0000_0000_0001UL, double)), rt::CANONICAL_NAN);
	test::eq(rt::double_value(-double::inf).is_double(), true);
}

fn void number_to_string_matches_node() @test
{
	char[40] buf;
	foreach (c : NUMBER_CASES)
	{
		double d = bitcast(c.bits, double);
		String got = rt::format_number(d, &buf);
		test::@check(got == c.want, "bits %x: got %s, want %s", c.bits, got, c.want);
	}
	test::eq(rt::format_number(double::nan, &buf), "NaN");
	test::eq(rt::format_number(-0.0, &buf), "0");
	test::eq(rt::format_number(-double::inf, &buf), "-Infinity");
}

fn void string_to_number() @test
{
	Heap h;
	h.init();
	defer h.free();
	test::eq(h.string_from_utf8("  42  ")!!.to_number(), 42.0);
	test::eq(h.string_from_utf8("")!!.to_number(), 0.0);
	test::eq(h.string_from_utf8("0x1f")!!.to_number(), 31.0);
	test::eq(h.string_from_utf8("-1.5e3")!!.to_number(), -1500.0);
	test::eq(h.string_from_utf8(".5")!!.to_number(), 0.5);
	test::eq(h.string_from_utf8("-Infinity")!!.to_number(), -double::inf);
	double nan = h.string_from_utf8("12px")!!.to_number();
	test::eq(nan != nan, true);
	nan = h.string_from_utf8("nan")!!.to_number();
	test::eq(nan != nan, true);
	nan = h.string_from_utf8("1_000")!!.to_number();
	test::eq(nan != nan, true);
}

fn void strings_are_canonical() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsString* a = h.string_from_utf8("héllo")!!;
	test::eq(a.wide, false);
	test::eq(a.len, 5u);
	JsString* b = h.string_from_utf8("π≈3")!!;
	test::eq(b.wide, true);
	test::eq(b.len, 3u);
	JsString* emoji = h.string_from_utf8("😀")!!;
	test::eq(emoji.len, 2u);
	test::eq(emoji.at(0), (ushort)0xD83D);
	// A slice of a wide string that only holds narrow units becomes narrow again.
	JsString* mixed = h.string_from_utf8("aπb")!!;
	JsString* left = h.substring(mixed, 0, 1)!!;
	test::eq(left.wide, false);
	test::eq(left.equals(h.string_from_utf8("a")!!), true);
	@pool()
	{
		test::eq(h.concat(a, b)!!.tutf8(), "héllo π≈3".replace(tmem, " ", ""));
		test::eq(emoji.tutf8(), "😀");
	};
}

fn void cooking_escapes() @test
{
	Heap h;
	h.init();
	defer h.free();
	@pool()
	{
		test::eq(h.cook(`a\nb\tc`, false)!!.tutf8(), "a\nb\tc");
		test::eq(h.cook(`\x41\u0042\u{1F600}`, false)!!.tutf8(), "AB😀");
		test::eq(h.cook(`it\'s \"q\"`, false)!!.tutf8(), "it's \"q\"");
		test::eq(h.cook("line\\\ncont", false)!!.tutf8(), "linecont");
		test::eq(h.cook("a\r\nb", true)!!.tutf8(), "a\nb");
		test::eq(h.cook(`\0`, false)!!.len, 1u);
	};
}

fn void atoms_are_unique() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsString* a = h.atom("length")!!;
	JsString* b = h.atom("length")!!;
	test::eq(a == b, true);
	test::eq(a.atom, true);
	// Enough atoms to force the table to grow.
	for (int i = 0; i < 1000; i++)
	{
		@pool()
		{
			(void)h.atom(string::tformat("key%d", i))!!;
		};
	}
	test::eq(h.atom("length")!! == a, true);
	@pool()
	{
		test::eq(h.atom("key999")!! == h.atom(string::tformat("key%d", 999))!!, true);
	};
}

fn void array_index_strings() @test
{
	Heap h;
	h.init();
	defer h.free();
	uint idx;
	test::eq(h.string_from_utf8("0")!!.array_index(&idx), true);
	test::eq(idx, 0u);
	test::eq(h.string_from_utf8("4294967294")!!.array_index(&idx), true);
	test::eq(h.string_from_utf8("4294967295")!!.array_index(&idx), false);
	test::eq(h.string_from_utf8("01")!!.array_index(&idx), false);
	test::eq(h.string_from_utf8("1e3")!!.array_index(&idx), false);
}

fn void shapes_are_shared() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsObject* proto = h.new_object(null)!!;
	Value x = rt::string_value(h.atom("x")!!);
	Value y = rt::string_value(h.atom("y")!!);
	JsObject* a = h.new_object(proto)!!;
	JsObject* b = h.new_object(proto)!!;
	a.add(&h, x, rt::integer(1))!!;
	a.add(&h, y, rt::integer(2))!!;
	b.add(&h, x, rt::integer(3))!!;
	b.add(&h, y, rt::integer(4))!!;
	test::eq(a.shape == b.shape, true);
	test::eq(a.proto() == proto, true);
	test::eq(a.find_own(y).slot(), 1u);
	test::eq(b.slots[b.find_own(y).slot()].as_int(), 4);
	// Same keys in another order is another shape.
	JsObject* c = h.new_object(proto)!!;
	c.add(&h, y, rt::integer(5))!!;
	c.add(&h, x, rt::integer(6))!!;
	test::eq(c.shape == a.shape, false);
	// Another prototype is another tree.
	JsObject* d = h.new_object(null)!!;
	d.add(&h, x, rt::integer(1))!!;
	test::eq(d.shape == a.shape, false);
}

fn void big_objects_use_a_table() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsObject* o = h.new_object(null)!!;
	Value[100] keys;
	for (int i = 0; i < 100; i++)
	{
		@pool()
		{
			keys[i] = rt::string_value(h.atom(string::tformat("k%d", i))!!);
		};
		o.add(&h, keys[i], rt::integer(i))!!;
	}
	for (int i = 0; i < 100; i++)
	{
		Shape* s = o.find_own(keys[i]);
		test::eq(o.slots[s.slot()].as_int(), i);
	}
	test::eq(o.find_own(rt::string_value(h.atom("missing")!!)) == null, true);
}

fn void delete_reshapes() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsObject* o = h.new_object(null)!!;
	Value a = rt::string_value(h.atom("a")!!);
	Value b = rt::string_value(h.atom("b")!!);
	Value c = rt::string_value(h.atom("c")!!);
	o.add(&h, a, rt::integer(1))!!;
	o.add(&h, b, rt::integer(2))!!;
	o.add(&h, c, rt::integer(3))!!;
	test::eq(o.remove(&h, b)!!, true);
	test::eq(o.shape.count, 2u);
	test::eq(o.find_own(b) == null, true);
	test::eq(o.slots[o.find_own(c).slot()].as_int(), 3);
	Shape*[2] nodes;
	o.shape.nodes(&nodes);
	test::eq(nodes[0].key == a && nodes[1].key == c, true);
}

fn void arrays_grow_with_holes() @test
{
	Heap h;
	h.init();
	defer h.free();
	JsArray* arr = h.new_array(null)!!;
	arr.push(rt::integer(1));
	arr.set(3, rt::integer(4));
	test::eq(arr.length, 4u);
	test::eq(arr.get(1) == rt::EMPTY, true);
	test::eq(arr.get(3).as_int(), 4);
	test::eq(arr.get(10) == rt::EMPTY, true);
	arr.set_length(2);
	test::eq(arr.length, 2u);
}
